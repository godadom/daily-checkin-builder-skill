# Copy values into your platform's secret store; never commit a populated .env.
CHECKIN_AUTH_TYPE=bearer
CHECKIN_TOKEN=replace-with-authorized-token
# For Cookie auth, set CHECKIN_AUTH_TYPE=cookie and place CHECKIN_COOKIE only in a protected secret store.
CHECKIN_ACCOUNT_NAME=default
# Alternative multi-account value (use instead of the single-account fields):
# CHECKIN_ACCOUNTS=[{"name":"account-a","auth_type":"bearer","token":"replace-with-authorized-token"}]
CHECKIN_CONNECT_TIMEOUT=5
CHECKIN_READ_TIMEOUT=15
CHECKIN_MAX_RETRIES=2
CHECKIN_JITTER_MAX_SECONDS=0
CHECKIN_TIMEZONE=Asia/Shanghai
CHECKIN_NOTIFY_MODE=log
